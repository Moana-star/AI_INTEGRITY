# Copy to .env and replace every placeholder with a unique secret.
POSTGRES_DB=eims
POSTGRES_USER=eims_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_FLASK_SECRET_KEY
# Used only once, when the PostgreSQL schema is empty.
EIMS_BOOTSTRAP_ADMIN_USERNAME=eims-admin
EIMS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
EIMS_HTTP_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
